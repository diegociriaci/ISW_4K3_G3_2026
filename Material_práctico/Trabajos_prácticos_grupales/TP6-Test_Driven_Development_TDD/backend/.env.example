PORT=3000
URL_FRONTEND=http://localhost:5173
DATABASE_PATH=./data/ecoharmony.db

# Usuario que representa la sesion simulada de la HU
TEST_USER_NAME=Visitante de prueba
TEST_USER_EMAIL=tu-email@example.com

# API key de Resend (resend.com > API Keys)
RESEND_API_KEY=
RESEND_FROM=EcoHarmony Park <onboarding@resend.dev>

# Access token de Mercado Pago (mercadopago.com.ar/developers > Tus integraciones
# > Credenciales). Si queda vacío, se usa el Mercado Pago simulado.
MP_ACCESS_TOKEN=

# Entorno de Mercado Pago: "prueba" (checkout sandbox, no cobra) o "produccion"
MP_ENTORNO=prueba
